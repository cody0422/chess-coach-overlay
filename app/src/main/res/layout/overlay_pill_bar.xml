<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:background="@drawable/bg_pill_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <!-- Play / Pause Auto-Arrows + tiny live status dot -->
    <FrameLayout
        android:id="@+id/btnPillPlayContainer"
        android:layout_width="46dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Play or Pause Arrows"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivPillPlay"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <View
            android:id="@+id/viewPillStatusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_status_dot" />
    </FrameLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginHorizontal="2dp"
        android:background="@color/pill_divider" />

    <!-- Settings menu -->
    <ImageButton
        android:id="@+id/btnPillSettings"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu" />

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginHorizontal="2dp"
        android:background="@color/pill_divider" />

    <!-- Close overlay -->
    <ImageButton
        android:id="@+id/btnPillClose"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Overlay"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />

</LinearLayout>
