<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@drawable/bg_pill_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <!-- Play / Analyze -->
    <ImageButton
        android:id="@+id/btnPillAnalyze"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Analyze"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <!-- Live Elo · Accuracy compact badge (also drag handle) -->
    <TextView
        android:id="@+id/tvPillStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:text="2000·100%"
        android:textColor="@color/accent_emerald"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="2dp"
        android:background="@color/pill_divider" />

    <!-- Align / Resize board -->
    <ImageButton
        android:id="@+id/btnPillAlign"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Align Board"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_align" />

    <!-- Touch Mode / Pass-through toggle -->
    <ImageButton
        android:id="@+id/btnPillTouchMode"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle Touch or Pass-through"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_touch" />

    <!-- Flip W/B -->
    <ImageButton
        android:id="@+id/btnPillFlip"
        android:layout_width="32dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Flip Board"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flip" />

    <!-- Undo -->
    <ImageButton
        android:id="@+id/btnPillUndo"
        android:layout_width="32dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Undo Move"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_undo" />

    <!-- Reset -->
    <ImageButton
        android:id="@+id/btnPillReset"
        android:layout_width="32dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Reset Game"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_reset" />

    <View
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="2dp"
        android:background="@color/pill_divider" />

    <!-- Settings menu -->
    <ImageButton
        android:id="@+id/btnPillSettings"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu" />

    <!-- Close overlay -->
    <ImageButton
        android:id="@+id/btnPillClose"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Overlay"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />

</LinearLayout>
